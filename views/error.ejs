<div class="text-center animate-up" style="padding:80px 24px;max-width:500px;margin:0 auto;">
  <div style="font-size:4rem;margin-bottom:16px;">❌</div>
  <h2 style="font-family:var(--font-h);font-size:2rem;color:var(--accent);margin-bottom:12px;">Something went wrong</h2>
  <p style="color:var(--text2);font-size:1rem;margin-bottom:32px;line-height:1.6;"><%= error || 'An unexpected error occurred' %></p>
  <div class="flex-gap" style="justify-content:center;">
    <a href="/"                       class="btn btn-primary"><i class="fas fa-home"></i> Go Home</a>
    <a href="javascript:history.back()" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Go Back</a>
  </div>
</div>
