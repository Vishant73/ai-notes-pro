<div class="auth-wrap">
  <div class="auth-side animate-up">
    <div class="logo-icon" style="width:56px;height:56px;font-size:24px;border-radius:16px;background:linear-gradient(135deg,var(--purple),var(--teal));display:flex;align-items:center;justify-content:center;color:white;">
      <i class="fas fa-brain"></i>
    </div>
    <h1>Welcome back 👋</h1>
    <p>Log in and continue turning your notes into powerful study material.</p>
    <div style="display:flex;flex-direction:column;gap:12px;margin-top:8px;">
      <div class="flex-gap text-muted"><i class="fas fa-check-circle" style="color:var(--teal)"></i> Instant AI summaries</div>
      <div class="flex-gap text-muted"><i class="fas fa-check-circle" style="color:var(--teal)"></i> Interactive quiz mode</div>
      <div class="flex-gap text-muted"><i class="fas fa-check-circle" style="color:var(--teal)"></i> PDF study pack export</div>
      <div class="flex-gap text-muted"><i class="fas fa-check-circle" style="color:var(--teal)"></i> Progress analytics</div>
    </div>
  </div>

  <div class="card animate-up delay-1">
    <h2 style="font-family:var(--font-h);font-size:1.5rem;font-weight:700;margin-bottom:6px;">Sign in</h2>
    <p class="text-muted mb-3">Enter your credentials to access your dashboard</p>

    <% if (error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label><i class="fas fa-envelope"></i> Email</label>
        <input type="email" name="email" placeholder="you@example.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label><i class="fas fa-lock"></i> Password</label>
        <input type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:8px;">
        <i class="fas fa-sign-in-alt"></i> Login
      </button>
    </form>

    <hr class="divider">
    <p class="text-center text-muted">Don't have an account? <a href="/register" style="color:var(--purple);font-weight:600;">Register here</a></p>
  </div>
</div>
